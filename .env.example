# Local PostgreSQL username for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose. Replace in local .env only.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible API base URL used by frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional image repository prefix for compose builds.
IMAGE_REPO=local

# Optional image tag for compose builds.
IMAGE_TAG=dev
